rules_version = '2';

// Strum — Firestore security rules (docs/phase-1-auth.md, data model in docs/README.md).
// Publish by pasting this file into Firebase console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function email()    { return request.auth.token.email.lower(); }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function isFriend() {
      return verified()
        && exists(/databases/$(database)/documents/allowedUsers/$(email()));
    }
    function isAdmin() {
      return verified()
        && exists(/databases/$(database)/documents/admins/$(email()));
    }
    function isMe(uid) { return isFriend() && request.auth.uid == uid; }

    // Admins: one doc per owner, added by hand in the console (docs/README.md → Invites).
    // Nobody can list or write it from the client.
    match /admins/{e} {
      allow get:   if signedIn() && e == email();
      allow list, write: if false;
    }

    // Friend allowlist. A user may check their own entry. Admins can list and remove friends.
    // Friends join in two ways: an admin adds the entry, or a verified user redeems an invite
    // by creating their own entry that points at a live invite code.
    match /allowedUsers/{e} {
      allow get:    if signedIn() && e == email();
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        || (verified() && e == email() && validRedemption(request.resource.data));
      allow update: if false;
    }

    // Invite codes. Only admins create or list them. Anyone signed in with a verified email can
    // read one invite by its exact code (codes are random and long, so they can't be guessed).
    // Redeeming may only increment `uses`; the expiry and limit can't be changed.
    match /invites/{code} {
      allow get:    if verified();
      allow list, delete: if isAdmin();
      allow create: if isAdmin()
        && validInvite(request.resource.data)
        && request.resource.data.createdBy == email();
      allow update: if verified()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses'])
        && request.resource.data.uses == resource.data.uses + 1
        && resource.data.uses < resource.data.maxUses
        && resource.data.expiresAt > request.time;
    }

    // Discover: a public copy of a song its owner chose to share (docs/README.md, Data model).
    // Any friend can read them. Only the owner can write, and only while their own private song
    // (same id) is public and not deleted after the same batch, so the two stay in step.
    // Deleting a doc that doesn't exist is allowed, so a soft delete needn't check first.
    match /publicSongs/{songId} {
      allow read: if isFriend();
      allow create, update: if isFriend()
        && request.resource.data.ownerUid == request.auth.uid
        && (resource == null || resource.data.ownerUid == request.auth.uid)
        && validPublicSong(request.resource.data)
        && ownSongIsPublic(songId);
      allow delete: if isFriend()
        && (resource == null || resource.data.ownerUid == request.auth.uid);
    }

    match /users/{uid} {
      allow read, write: if isMe(uid);

      match /songs/{songId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validSong(request.resource.data);
      }
      match /playlists/{playlistId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validPlaylist(request.resource.data);
      }
      match /folders/{folderId} {
        allow read, delete: if isMe(uid);
        allow create, update: if isMe(uid) && validFolder(request.resource.data);
      }
    }

    function validSong(d) {
      return d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.artist is string && d.artist.size() <= 200
        && d.cloudinaryPublicId is string
        && d.audioUrl is string && d.audioUrl.matches('https://res\\.cloudinary\\.com/.*')
        && d.durationSec is number
        && d.deleted is bool
        && (!('isPublic' in d) || d.isPublic is bool);
    }
    function validPublicSong(d) {
      return d.ownerUid is string
        && d.ownerName is string && d.ownerName.size() > 0 && d.ownerName.size() <= 100
        && d.title is string && d.title.size() > 0 && d.title.size() <= 200
        && d.artist is string && d.artist.size() <= 200
        && d.cloudinaryPublicId is string
        && d.audioUrl is string && d.audioUrl.matches('https://res\\.cloudinary\\.com/.*')
        && d.durationSec is number
        && d.searchKeywords is list
        && d.sharedAt is timestamp;
    }
    // The caller's own private song with this id, as it will be after this write/batch.
    function ownSongIsPublic(songId) {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/songs/$(songId);
      return existsAfter(path)
        && getAfter(path).data.isPublic == true
        && getAfter(path).data.deleted == false;
    }
    function validPlaylist(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100
        && d.songIds is list && d.songIds.size() <= 5000;
    }
    function validFolder(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 100;
    }
    function validInvite(d) {
      return d.createdBy is string
        && d.createdAt is timestamp
        && d.expiresAt is timestamp
        && d.maxUses is int && d.maxUses >= 1 && d.maxUses <= 50
        && d.uses == 0
        && d.note is string && d.note.size() <= 100;
    }
    // A redemption must name a live invite (not expired, uses left) and carry the timestamp.
    function validRedemption(d) {
      return d.inviteCode is string
        && d.addedAt is timestamp
        && exists(/databases/$(database)/documents/invites/$(d.inviteCode))
        && get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.expiresAt > request.time
        && get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.uses
             < get(/databases/$(database)/documents/invites/$(d.inviteCode)).data.maxUses;
    }
  }
}
