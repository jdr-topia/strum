# Copy this file to .env.local and fill in the values.
#   cp .env.example .env.local
# .env.local is git-ignored. None of these are secrets — they are public client config —
# but keep them out of git anyway so the repo stays project-agnostic.
#
# NEVER add the Cloudinary API secret or any Firebase service-account key here.

# --- Firebase ---------------------------------------------------------------
# Firebase console → Project settings (gear) → General → Your apps → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Cloudinary -------------------------------------------------------------
# Cloudinary dashboard → "Cloud name"
VITE_CLOUDINARY_CLOUD_NAME=
# Settings → Upload → Upload presets → your UNSIGNED preset's name
VITE_CLOUDINARY_UPLOAD_PRESET=

# --- App options (optional; defaults shown) ---------------------------------
# Max upload size per file in MB (Cloudinary free plan hard limit is 100)
VITE_MAX_UPLOAD_MB=50
# Streaming quality: "128k" (transcoded, saves bandwidth) or "original"
VITE_STREAM_QUALITY=128k
